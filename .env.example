# Copy to .env and fill in. Never commit .env.

# --- API (services/api)
API_PORT=4000
API_HOST=127.0.0.1
# SQLite file for dev; Postgres URL in prod (later milestone)
DATABASE_PATH=services/api/data/myna.db
# Shared secret the agent uses to call the API's tool endpoints
AGENT_API_TOKEN=change-me-dev-token

# --- Agent (services/agent)
AGENT_PORT=8000
API_BASE_URL=http://127.0.0.1:4000
# Understanding provider: "sarvam" (needs SARVAM_API_KEY; falls back to rules if Sarvam fails)
# or "rules" (deterministic, offline — fine for local dev and tests)
LLM_PROVIDER=rules
SARVAM_API_KEY=
# Voice agents: sarvam-105b-conversations (fast, answers directly). sarvam-105b is a reasoning
# model that can spend a small token budget on thinking and return nothing.
SARVAM_MODEL=sarvam-105b-conversations

# --- Shared state (optional). Unset = everything in memory, fine for one instance.
# With several instances (Cloud Run) set the same URL on the API, the agent and the web app:
# live-call state, reminder claims, rate limits and the config cache then live in Redis.
# Local: docker compose up -d redis
REDIS_URL=
